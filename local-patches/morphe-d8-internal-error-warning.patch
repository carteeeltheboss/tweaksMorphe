+                val sdkVerifier = SdkDexVerifier(config.sdkToolsPath)
+                object : DexVerifier {
+                    private fun verifyWithInternalErrorFallback(action: () -> Unit) {
+                        try {
+                            action()
+                        } catch (e: Exception) {
+                            val detail = e.message.orEmpty()
+                            if ("d8 failed" in detail && "Compilation failed with an internal error" in detail) {
+                                warn("SDK DEX verification warning: ${e.message}")
+                            } else {
+                                throw e
+                            }
+                        }
+                    }
+
+                    override fun verifyDexFile(dexFile: File) =
+                        verifyWithInternalErrorFallback { sdkVerifier.verifyDexFile(dexFile) }
+
+                    override fun verifyDexDirectory(dexDir: File) =
+                        verifyWithInternalErrorFallback { sdkVerifier.verifyDexDirectory(dexDir) }
+
+                    override fun verifyApkFile(apkFile: File) =
+                        verifyWithInternalErrorFallback { sdkVerifier.verifyApkFile(apkFile) }
+                }
             } else {
                 NoOpDexVerifier
             }
